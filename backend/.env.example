PORT=3000
NODE_ENV=development

# ─── Database ────────────────────────────────────────────────────────────────
# Local Docker (matches docker-compose.yml)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/hrm?schema=public"
DIRECT_URL="postgresql://postgres:postgrespassword@localhost:5432/hrm?schema=public"

# Connection pool overrides (optional — defaults: dev=10, prod=15)
# DB_CONNECTION_LIMIT=15
# DB_POOL_TIMEOUT=10

# ─── Auth ─────────────────────────────────────────────────────────────────────
# REQUIRED in production — use a long random string (e.g. openssl rand -base64 64)
JWT_SECRET="your-secure-jwt-secret-key"

# ─── Email (BullMQ / Nodemailer) ─────────────────────────────────────────────
# Gmail with App Password (https://myaccount.google.com/apppasswords)
EMAIL_USER="your-email@gmail.com"
EMAIL_PASSWORD="your-app-password"

# Custom SMTP (optional — if set, EMAIL_HOST overrides Gmail service)
# EMAIL_HOST="smtp.yourdomain.com"
# EMAIL_PORT=587

# ─── Frontend URL ─────────────────────────────────────────────────────────────
# Used for password-setup invitation links sent to new employees
FRONTEND_URL="http://localhost:5173"

# ─── Redis (optional — required only for multi-replica Socket.IO scaling) ─────
# If omitted, Socket.IO runs in single-node in-memory mode (fine for single server)
# Use REDIS_URL -or- REDIS_HOST/PORT/PASSWORD — not both
# REDIS_URL="redis://:password@localhost:6379"
# REDIS_HOST="localhost"
# REDIS_PORT=6379
# REDIS_PASSWORD="yourredispassword"
