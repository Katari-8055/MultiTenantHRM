PORT=3000

# PostgreSQL Connection (Local or Supabase)
# Configure connection_limit and pool_timeout for production connection pooling
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/hrm?schema=public&connection_limit=15&pool_timeout=10"
DIRECT_URL="postgresql://postgres:postgrespassword@localhost:5432/hrm?schema=public"

# Connection pool overrides (optional)
# DB_CONNECTION_LIMIT=15
# DB_POOL_TIMEOUT=10

JWT_SECRET="your-secure-jwt-secret-key"
EMAIL_USER="your-email@gmail.com"
EMAIL_PASSWORD="your-app-password"

FRONTEND_URL="http://localhost:5173"
NODE_ENV="development"

# Redis Configuration for Multi-Replica Socket.IO Scaling (Optional)
# Specify REDIS_URL or host/port/password credentials
# REDIS_URL="redis://:password@localhost:6379"
# REDIS_HOST="localhost"
# REDIS_PORT=6379
# REDIS_PASSWORD="password"
